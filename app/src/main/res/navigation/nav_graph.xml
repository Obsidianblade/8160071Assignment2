<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's three destinations and the routes between them.
    Safe Args generates LoginFragmentDirections, DashboardFragmentArgs, etc. from this file.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.booknest.ui.login.LoginFragment"
        tools:layout="@layout/fragment_login">

        <!-- popUpTo removes Login from the back stack: Back on the Dashboard leaves the app
             instead of returning to the login form. -->
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.booknest.ui.dashboard.DashboardFragment"
        tools:layout="@layout/fragment_dashboard">

        <!-- The keypass returned by the login API; DashboardViewModel reads it -->
        <argument
            android:name="keypass"
            app:argType="string" />

        <action
            android:id="@+id/action_dashboardFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.booknest.ui.details.DetailsFragment"
        tools:layout="@layout/fragment_details">

        <!-- The selected book (Parcelable thanks to @Parcelize) -->
        <argument
            android:name="book"
            app:argType="com.example.booknest.data.model.Book" />
    </fragment>

</navigation>
